{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "shipbox-engine",
	"main": "src/index.ts",
	"compatibility_date": "2025-05-06",
	"compatibility_flags": ["nodejs_compat"],

	"observability": {
		"enabled": true
	},

	// Container configuration for Sandbox
	// The Dockerfile extends cloudflare/sandbox with OpenCode installed
	"containers": [
		{
			"class_name": "Sandbox",
			"image": "./Dockerfile",
			"instance_type": "standard-2",
			"max_instances": 10
		}
	],

	// Durable Objects
	"durable_objects": {
		"bindings": [
			{
				"name": "MCP_AGENT",
				"class_name": "OpenCodeMcpAgent"
			},
			{
				"name": "Sandbox",
				"class_name": "Sandbox"
			}
		]
	},

	// SQLite storage for DOs
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["OpenCodeMcpAgent", "Sandbox"]
		}
	],

	// R2 bucket for session persistence (workspace files + OpenCode state)
	"r2_buckets": [
		{
			"binding": "SESSIONS_BUCKET",
			"bucket_name": "shipbox-sessions"
		}
	],

	// Workflows for long-running tasks
	"workflows": [
		{
			"name": "execute-task-workflow",
			"binding": "EXECUTE_TASK_WORKFLOW",
			"class_name": "ExecuteTaskWorkflow"
		}
	],

	// Environment variables
	// Secrets (R2 creds, ANTHROPIC_API_KEY, GITHUB_TOKEN) via wrangler secret put
	"vars": {
		"ENVIRONMENT": "development"
	}
}
