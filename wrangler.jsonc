{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sandbox-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2025-12-21",
	"compatibility_flags": ["nodejs_compat"],

	"observability": {
		"enabled": true
	},

	// Durable Objects - our MCP Agent
	"durable_objects": {
		"bindings": [
			{
				"name": "MCP_AGENT",
				"class_name": "OpenCodeMcpAgent"
			}
		]
	},

	// SQLite storage for the DO
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["OpenCodeMcpAgent"]
		}
	],

	// Sandbox binding - connects to Cloudflare Sandbox infrastructure
	// This requires the sandbox product to be enabled on the account
	"containers": {
		"SANDBOX": {
			"image": "@cloudflare/sandbox:opencode"
		}
	},

	// R2 bucket for session persistence (workspace files + OpenCode state)
	"r2_buckets": [
		{
			"binding": "SESSIONS_BUCKET",
			"bucket_name": "opencode-sessions"
		}
	],

	// Workflows for long-running tasks
	"workflows": [
		{
			"name": "execute-task-workflow",
			"binding": "EXECUTE_TASK_WORKFLOW",
			"class_name": "ExecuteTaskWorkflow"
		}
	],

	// Environment variables
	// Secrets (R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, ANTHROPIC_API_KEY) 
	// should be set via wrangler secret put
	"vars": {
		"ENVIRONMENT": "development"
	}
}
