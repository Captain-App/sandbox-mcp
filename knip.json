{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/index.ts"],
  "project": ["src/**/*.ts"],
  "ignore": ["src/**/*.test.ts"],
  "includeEntryExports": true,
  "ignoreDependencies": [
    "cloudflare"
  ],
  "wrangler": {
    "config": ["wrangler.jsonc"]
  },
  "vitest": {
    "entry": ["src/**/*.test.ts"]
  }
}
