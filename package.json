{
	"name": "sandbox-mcp",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "lefthook install",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"dev:inspect": "concurrently \"wrangler dev\" \"npx @modelcontextprotocol/inspector\" --kill-others",
		"start": "wrangler dev",
		"cf-typegen": "wrangler types",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "oxlint",
		"format": "oxfmt src/",
		"format:check": "oxfmt --check src/",
		"typecheck": "tsc --noEmit",
		"knip": "knip",
		"check": "npm run typecheck && npm run format:check && npm run lint && npm run knip && npm run test"
	},
	"dependencies": {
		"@cloudflare/sandbox": "^0.6.7",
		"@modelcontextprotocol/sdk": "^1.25.1",
		"@opencode-ai/sdk": "^1.0.184",
		"agents": "^0.2.34",
		"effect": "^3.19.13",
		"jose": "^6.1.3",
		"zod": "^4.2.1"
	},
	"overrides": {
		"@modelcontextprotocol/sdk": "^1.25.1"
	},
	"devDependencies": {
		"@types/node": "^25.0.3",
		"concurrently": "^9.2.1",
		"knip": "^5.76.2",
		"lefthook": "^2.0.12",
		"oxfmt": "^0.19.0",
		"oxlint": "^1.34.0",
		"typescript": "^5.9.3",
		"vitest": "^4.0.16",
		"wrangler": "^4.56.0"
	}
}
