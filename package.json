{
  "name": "sandbox-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "dev:inspect": "concurrently \"wrangler dev\" \"npx @modelcontextprotocol/inspector\" --kill-others",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "check": "npm run typecheck && npm run format:check && npm run lint && npm run knip && npm run test"
  },
  "dependencies": {
    "@cloudflare/sandbox": "^0.6.7",
    "@microlabs/otel-cf-workers": "^1.0.0-rc.52",
    "@modelcontextprotocol/sdk": "^1.23.0",
    "@opencode-ai/sdk": "^1.0.184",
    "@sentry/cloudflare": "^10.32.1",
    "@shipbox/shared": "*",
    "agents": "^0.2.34",
    "ai": "^6.0.27",
    "effect": "^3.19.13",
    "jose": "^6.1.3",
    "zod": "^4.2.1"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "^1.25.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.1",
    "@cloudflare/workers-types": "^4.20260111.0",
    "@types/node": "^25.0.3",
    "concurrently": "^9.2.1",
    "knip": "^5.76.2",
    "lefthook": "^2.0.12",
    "oxfmt": "^0.19.0",
    "oxlint": "^1.34.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "wrangler": "^4.56.0"
  }
}
